{
  "name": "xeonb-crm",
  "version": "1.0.0",
  "description": "CRM for Brightlys Assetic Asset Management API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec ts-node src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "migrate": "ts-node src/server/database/migrate.ts",
    "migrate:rollback": "ts-node src/server/database/migrate.ts rollback",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^5.1.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.7.0",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "tedious": "^18.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.8.9",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.14",
    "@types/passport-local": "^1.0.37",
    "@types/pdfkit": "^0.13.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "crm",
    "assetic",
    "asset-management"
  ],
  "author": "",
  "license": "ISC"
}
